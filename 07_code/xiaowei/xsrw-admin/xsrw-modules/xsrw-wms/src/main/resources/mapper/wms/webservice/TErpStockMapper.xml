    <sql id="selectTErpStockVo">
        select id, werks, lgort, lgnum, lgtyp, matnr, makt, charg, lgpla, lgber, lifnr, name1, gesme, verpr, salkv, meins, bestq, sobkz, posid, field1, field2, field3, field4, field5, create_by, create_time, update_by, update_time from t_erp_stock
    </sql>

    <select id="selectTErpStockList" parameterType="com.xsrw.wms.webservice.domain.TErpStock"
            resultMap="TErpStockResult">
        select a.id, a.werks, a.lgort, a.lgnum, a.lgtyp, a.matnr, a.makt, a.charg, a.lgpla, a.lgber, a.lifnr,
        a.name1, a.gesme, a.verpr, a.salkv, a.meins, a.bestq, a.sobkz, a.posid, a.field1, a.field2, a.field3, a.field4,
        a.field5, a.create_by, a.create_time, a.update_by, a.update_time,
        b.name as locationName,
        ts.count as stockCount
        from t_erp_stock a
        left join t_location b on b.erp_code = a.lgpla
        left join t_material tm on a.matnr = tm.code
        left join t_stock ts on tm.id = ts.material_id and b.id = ts.location_id and a.charg = ts.batch_code and ts.del_flag = '0'
        <where>
            <if test="werks != null  and werks != ''">and a.werks = #{werks}</if>
            <if test="lgort != null  and lgort != ''">and a.lgort = #{lgort}</if>
            <if test="lgnum != null  and lgnum != ''">and a.lgnum = #{lgnum}</if>
            <if test="lgtyp != null  and lgtyp != ''">and a.lgtyp = #{lgtyp}</if>
            <if test="matnr != null  and matnr != ''">and a.matnr = #{matnr}</if>
            <if test="makt != null  and makt != ''">and a.makt = #{makt}</if>
            <if test="charg != null  and charg != ''">and a.charg = #{charg}</if>
            <if test="lgpla != null  and lgpla != ''">and a.lgpla = #{lgpla}</if>
            <if test="lgber != null  and lgber != ''">and a.lgber = #{lgber}</if>
            <if test="lifnr != null  and lifnr != ''">and a.lifnr = #{lifnr}</if>
            <if test="name1 != null  and name1 != ''">and a.name1 = #{name1}</if>
            <if test="gesme != null ">and a.gesme = #{gesme}</if>
            <if test="verpr != null ">and a.verpr = #{verpr}</if>
            <if test="salkv != null ">and a.salkv = #{salkv}</if>
            <if test="meins != null  and meins != ''">and a.meins = #{meins}</if>
            <if test="bestq != null  and bestq != ''">and a.bestq = #{bestq}</if>
            <if test="sobkz != null  and sobkz != ''">and a.sobkz = #{sobkz}</if>
            <if test="posid != null  and posid != ''">and a.posid = #{posid}</if>
            <if test="field1 != null  and field1 != ''">and a.field1 = #{field1}</if>
            <if test="field2 != null  and field2 != ''">and a.field2 = #{field2}</if>
            <if test="field3 != null  and field3 != ''">and a.field3 = #{field3}</if>
            <if test="field4 != null  and field4 != ''">and a.field4 = #{field4}</if>
            <if test="field5 != null  and field5 != ''">and a.field5 = #{field5}</if>
        </where>
        order by a.create_time desc
    </select>

    <select id="selectTErpStockById" parameterType="Long" resultMap="TErpStockResult">
        <include refid="selectTErpStockVo"/>
