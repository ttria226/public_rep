<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xsrw.wms.base.mapper.TCodeConfigMapper">

    <resultMap type="com.xsrw.wms.base.domain.TCodeConfig" id="CodeConfigResult">
        <result property="id" column="id"/>
        <result property="type" column="type"/>
        <result property="typeCode" column="type_code"/>
        <result property="beforeCode" column="before_code"/>
        <result property="middleDate" column="middle_date"/>
        <result property="afterNumberType" column="after_number_type"/>
        <result property="ruleValue" column="rule_value"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>

    <sql id="selectCodeConfigVo">
        select id, type, type_code, before_code, middle_date, after_number_type, rule_value, create_by, create_time, update_by, update_time, remark, del_flag from t_code_config
    </sql>

    <select id="selectCodeConfigList" parameterType="com.xsrw.wms.base.domain.TCodeConfig" resultMap="CodeConfigResult">
        <include refid="selectCodeConfigVo"/>
        <where>
            del_flag = '0'
            <if test="type != null  and type != ''">and type = #{type}</if>
            <if test="typeCode != null  and typeCode != ''">and type_code = #{typeCode}</if>
            <if test="beforeCode != null  and beforeCode != ''">and before_code = #{beforeCode}</if>
            <if test="middleDate != null  and middleDate != ''">and middle_date = #{middleDate}</if>
            <if test="afterNumberType != null  and afterNumberType != ''">and after_number_type = #{afterNumberType}
            </if>
            <if test="ruleValue != null  and ruleValue != ''">and rule_value = #{ruleValue}</if>
        </where>
    </select>

    <select id="selectCodeConfigById" parameterType="Long" resultMap="CodeConfigResult">
        <include refid="selectCodeConfigVo"/>
        where id = #{id} and del_flag = '0'
    </select>


    <update id="deleteCodeConfigById" parameterType="Long">
        update t_code_config set del_flag = '1' where id = #{id}
    </update>

    <update id="deleteCodeConfigByIds" parameterType="String">
        update t_code_config set del_flag = '1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>
